{
  "$defs": {
    "Automation": {
      "additionalProperties": false,
      "description": "Parameter automation over time.\n\n``points`` are ``[bar, value]`` pairs; bars are 1-indexed, fractional\nallowed, in [1, length_bars + 1] (length_bars + 1 = end of song).\nValue units are the target parameter's own units and must stay inside\nthe parameter's declared bounds. ``curve``: ``lin`` linear, ``exp``\nexponential (values must be non-zero and same-sign), ``step`` holds\nthe previous value.\n\nSemantics: automation REPLACES the target's static value entirely;\nbefore the first point it holds the first value, after the last\npoint it holds the last value. Two automations may not share a\ntarget. NaN/inf values are rejected everywhere.",
      "properties": {
        "curve": {
          "default": "lin",
          "enum": [
            "lin",
            "exp",
            "step"
          ],
          "title": "Curve",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "target": {
          "description": "tracks.<track_id>.gain_db | tracks.<track_id>.pan | tracks.<track_id>.fx.<fx_id>.<param> | tracks.<track_id>.fx.<fx_id>.params.<name> | master.gain_db | master.fx.<fx_id>.<param> | master.fx.<fx_id>.params.<name>",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "points"
      ],
      "title": "Automation",
      "type": "object"
    },
    "Chop": {
      "additionalProperties": false,
      "description": "A loop cut from a source stem, aligned to the source's real grid.",
      "properties": {
        "fade_ms": {
          "default": 5.0,
          "description": "Seam crossfade (ms) between back-to-back repeats; fade to/from silence only at the first start and last end of a run. 0 = hard cuts.",
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fade Ms",
          "type": "number"
        },
        "id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "length_beats": {
          "exclusiveMinimum": 0,
          "maximum": 128,
          "title": "Length Beats",
          "type": "number"
        },
        "source": {
          "description": "id of a sources[] entry.",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "start_downbeat": {
          "description": "1-based index into analysis.json downbeats_s.",
          "minimum": 1,
          "title": "Start Downbeat",
          "type": "integer"
        },
        "start_offset_beats": {
          "default": 0.0,
          "description": "Beats to shift the start along beats_s from the downbeat's matching beat; may be negative, fractional interpolates. Enables off-downbeat starts and stutters.",
          "maximum": 4096.0,
          "minimum": -4096.0,
          "title": "Start Offset Beats",
          "type": "number"
        },
        "stem": {
          "default": "other",
          "enum": [
            "drums",
            "bass",
            "vocals",
            "other",
            "mix"
          ],
          "title": "Stem",
          "type": "string"
        },
        "warp": {
          "$ref": "#/$defs/Warp"
        }
      },
      "required": [
        "id",
        "source",
        "start_downbeat",
        "length_beats"
      ],
      "title": "Chop",
      "type": "object"
    },
    "ChorusFx": {
      "additionalProperties": false,
      "properties": {
        "centre_delay_ms": {
          "default": 7.0,

          "minimum": 0.0,
          "title": "Mix",
          "type": "number"
        },
        "rate_hz": {
          "default": 1.0,
          "maximum": 20.0,
          "minimum": 0.01,
          "title": "Rate Hz",
          "type": "number"
        },

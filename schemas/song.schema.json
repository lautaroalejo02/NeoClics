    "Pattern": {
      "additionalProperties": false,
      "description": "Step-sequenced drum pattern, tiled across the track's window.\n\nEach lane's ``steps`` string must be exactly\n``steps_per_bar * bars`` characters (ignoring spaces).\n\n``swing`` in [0, 1] delays every odd-indexed (off) step by\n``swing * step / 3``: 0 is straight, 1 is full triplet swing.",
      "properties": {
        "bars": {
          "default": 1,
          "maximum": 4096,
          "minimum": 1,
          "title": "Bars",
          "type": "integer"
        },
        "lanes": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/PatternLane"
            }
          },
          "propertyNames": {
            "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": "Lanes",
          "type": "object"
        },
        "steps_per_bar": {
          "default": 16,
          "maximum": 64,
          "minimum": 1,
          "title": "Steps Per Bar",
          "type": "integer"
        },
        "swing": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Swing",
          "type": "number"
        }
      },
      "required": [
        "lanes"
      ],
      "title": "Pattern",
      "type": "object"
    },
    "PatternLane": {

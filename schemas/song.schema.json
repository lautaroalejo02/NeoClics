        "feedback": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Feedback",
          "type": "number"
        },
        "id": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "mix": {
          "default": 0.5,

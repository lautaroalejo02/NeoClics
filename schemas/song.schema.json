    "Warp": {
      "additionalProperties": false,
      "description": "How source audio conforms to the project tempo.\n\n* ``resample``: the playback rate is set by tempo ONLY,\n  ``project_bpm / source_local_bpm``, so the chop always fills its\n  grid slot exactly; the tempo-induced pitch change IS the vinyl\n  effect. A single rate is used for the whole chop.\n* ``stretch``: pitch-preserving time-stretch to the grid (Rubber\n  Band; each source beat is mapped onto the project grid, beat-wise).\n\nIn both modes ``pitch_semitones`` is an additional LENGTH-PRESERVING\npitch shift (high-quality shifter), applied after the warp \u2014 it never\nchanges the chop's grid span.",
      "properties": {
        "mode": {
          "default": "resample",
          "enum": [
            "resample",
            "stretch"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pitch_semitones": {
          "default": 0.0,
          "maximum": 24.0,
          "minimum": -24.0,
          "title": "Pitch Semitones",
          "type": "number"
        }
      },
      "title": "Warp",
      "type": "object"
    }

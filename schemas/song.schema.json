    "SidechainFx": {
      "additionalProperties": false,
      "description": "Ducks this track whenever the ``key_track`` produces an event.\n\nThe key signal is EVENT-triggered: when the key track has events\n(pattern steps or notes), the envelope ``env`` jumps to 1 at each\ntrigger and decays with ``release_ms``; ``attack_ms`` ramps the jump.\nThe track's gain is scaled by ``1 - depth * env`` (0 = off, 1 = full\nduck to silence).\n\n``key_lane`` (optional) restricts triggers to one drum lane of a\npattern track (e.g. ``kick``); it must name an existing lane. If the\nkey track is a clips track (no events), the renderer falls back to an\naudio envelope follower on that track's stem.\n\nSidechain chains that form a cycle (A keys on B, B keys on A) are a\nvalidation error.",
      "properties": {
        "attack_ms": {
          "default": 1.0,
          "maximum": 500.0,
          "minimum": 0.0,
          "title": "Attack Ms",
          "type": "number"
        },
        "depth": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Depth",
          "type": "number"
        },
        "id": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "key_lane": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict triggers to this lane of a pattern key track (e.g. 'kick'). Must exist.",
          "title": "Key Lane"
        },
        "key_track": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Key Track",
          "type": "string"
        },
        "release_ms": {
          "default": 120.0,
          "exclusiveMinimum": 0.0,
          "maximum": 5000.0,
          "title": "Release Ms",
          "type": "number"
        },
        "type": {
          "const": "sidechain",
          "default": "sidechain",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key_track",
        "depth"
      ],
      "title": "SidechainFx",
      "type": "object"
    },

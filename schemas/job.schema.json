{
  "additionalProperties": false,
  "description": "State of a long-running tool invocation (``GET /jobs/<id>``).",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The tool's ToolResult envelope once done/failed.",
      "title": "Result"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool": {
      "description": "Tool name, e.g. 'source.separate'.",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tool",
    "status"
  ],
  "title": "Job",
  "type": "object"
}

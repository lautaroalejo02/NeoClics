{
  "$defs": {
    "GridAlternative": {
      "additionalProperties": false,
      "description": "Another plausible reading of the grid, as ready-to-pass source.regrid params.",
      "properties": {
        "beat_phase": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Beat Phase",
          "type": "integer"
        },
        "bpm": {
          "description": "Global tempo of this reading.",
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "downbeat_shift_beats": {
          "default": 0,
          "title": "Downbeat Shift Beats",
          "type": "integer"
        },
        "label": {
          "description": "Short Spanish description for the human.",
          "title": "Label",
          "type": "string"
        },
        "tempo_factor": {
          "enum": [
            0.5,
            1.0,
            2.0
          ],
          "title": "Tempo Factor",
          "type": "number"
        }
      },
      "required": [
        "tempo_factor",
        "bpm",
        "label"
      ],
      "title": "GridAlternative",
      "type": "object"
    },
    "GridBar": {
      "additionalProperties": false,
      "properties": {
        "beat_count": {
          "minimum": 0,
          "title": "Beat Count",
          "type": "integer"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reliable": {
          "title": "Reliable",
          "type": "boolean"
        },
        "start_downbeat": {
          "minimum": 1,
          "title": "Start Downbeat",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "reliable",
        "reason",
        "start_downbeat",
        "beat_count"
      ],
      "title": "GridBar",
      "type": "object"
    },
    "GridCorrection": {
      "additionalProperties": false,
      "description": "How the effective grid (``beats_s``/``downbeats_s``) derives from the tracker.\n\nAll parameters are ABSOLUTE, relative to ``raw`` (the tracker output):\napplying the same correction twice is a no-op, and\n``tempo_factor: 1, downbeat_shift_beats: 0`` gives back the raw grid.",
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/GridAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "ask_human": {
          "description": "True when the agent should have the human confirm the grid by ear.",
          "title": "Ask Human",
          "type": "boolean"
        },
        "bar_phase_confidence": {
          "description": "How sure the downbeat position is (heuristic).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Bar Phase Confidence",
          "type": "number"
        },
        "beat_phase": {
          "default": 0,
          "description": "With tempo_factor 0.5: which of every two tracked beats is kept (0 = the 1st, 3rd, ... tracked beat).",
          "enum": [
            0,
            1
          ],
          "title": "Beat Phase",
          "type": "integer"
        },
        "beats_per_bar": {
          "default": 4,
          "maximum": 12,
          "minimum": 2,
          "title": "Beats Per Bar",
          "type": "integer"
        },
        "downbeat_shift_beats": {
          "default": 0,
          "description": "Corrected beats the downbeat (the 'one') is moved from where the tracker put it; +1 = one beat later.",
          "maximum": 16,
          "minimum": -16,
          "title": "Downbeat Shift Beats",
          "type": "integer"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/GridStep"
          },
          "title": "History",
          "type": "array"
        },
        "origin": {
          "description": "tracker = raw grid as tracked; auto = source.analyze picked the tempo octave inside tempo_range_bpm; manual = source.regrid.",
          "enum": [
            "tracker",
            "auto",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/RawGrid"
        },
        "reason": {
          "description": "Spanish: what was read, what was applied and why.",
          "title": "Reason",
          "type": "string"
        },
        "tempo_confidence": {
          "description": "How sure the tempo octave is (heuristic, not a probability).",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tempo Confidence",
          "type": "number"
        },
        "tempo_factor": {
          "default": 1.0,
          "enum": [
            0.5,
            1.0,
            2.0
          ],
          "title": "Tempo Factor",
          "type": "number"
        },
        "tempo_range_bpm": {
          "default": [
            70.0,
            160.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Tempo Range Bpm",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "raw",
        "tempo_confidence",
        "bar_phase_confidence",
        "ask_human",
        "reason"
      ],
      "title": "GridCorrection",
      "type": "object"
    },
    "GridRegion": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reliable": {
          "title": "Reliable",
          "type": "boolean"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "reliable",
        "reason"
      ],
      "title": "GridRegion",
      "type": "object"
    },
    "GridReliability": {
      "additionalProperties": false,
      "properties": {
        "bars": {
          "items": {
            "$ref": "#/$defs/GridBar"
          },
          "title": "Bars",
          "type": "array"
        },
        "confidence": {
          "description": "Reliable fraction of complete bars; heuristic.",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/GridRegion"
          },
          "title": "Regions",
          "type": "array"
        }
      },
      "required": [
        "confidence",
        "hint"
      ],
      "title": "GridReliability",
      "type": "object"
    },
    "GridStep": {
      "additionalProperties": false,
      "description": "One applied correction (history; the newest is the current one).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "beat_phase": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Beat Phase",
          "type": "integer"
        },
        "beats_per_bar": {
          "default": 4,
          "title": "Beats Per Bar",
          "type": "integer"
        },
        "downbeat_shift_beats": {
          "default": 0,
          "title": "Downbeat Shift Beats",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "auto",
            "manual",
            "reset"
          ],
          "title": "Origin",
          "type": "string"
        },
        "tempo_factor": {
          "enum": [
            0.5,
            1.0,
            2.0
          ],
          "title": "Tempo Factor",
          "type": "number"
        }
      },
      "required": [
        "at",
        "origin",
        "tempo_factor"
      ],
      "title": "GridStep",
      "type": "object"
    },
    "KeyEstimate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "title": "Mode",
          "type": "string"
        },
        "tonic": {
          "description": "Tonic note, e.g. 'A', 'F#', 'Bb'.",
          "pattern": "^[A-G](#|b)?$",
          "title": "Tonic",
          "type": "string"
        }
      },
      "required": [
        "tonic",
        "mode",
        "confidence"
      ],
      "title": "KeyEstimate",
      "type": "object"
    },
    "RawGrid": {
      "additionalProperties": false,
      "description": "The beat tracker's own output, kept so grid corrections are reversible.",
      "properties": {
        "beats_s": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Beats S",
          "type": "array"
        },
        "bpm_global": {
          "exclusiveMaximum": 400.0,
          "exclusiveMinimum": 0.0,
          "title": "Bpm Global",
          "type": "number"
        },
        "downbeats_s": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Downbeats S",
          "type": "array"
        },
        "tempo_variable": {
          "default": false,
          "title": "Tempo Variable",
          "type": "boolean"
        }
      },
      "required": [
        "bpm_global",
        "beats_s",
        "downbeats_s"
      ],
      "title": "RawGrid",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "minimum": 0.0,
          "title": "End S",
          "type": "number"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start_s": {
          "minimum": 0.0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "label",
        "start_s",
        "end_s"
      ],
      "title": "Section",
      "type": "object"
    },
    "Stems": {
      "additionalProperties": false,
      "description": "Relative paths to separated stem files under cache/stems/<source_id>/.\n\nAt least one stem must be present; a 2-stem separation may only have\nsome of them. The full mix is the source file itself, so there is no\n'mix' field here ('mix' exists only as a chop stem choice).",
      "properties": {
        "bass": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bass"
        },
        "drums": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drums"
        },
        "other": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other"
        },
        "vocals": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocals"
        }
      },
      "title": "Stems",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "beats_s": {
      "items": {
        "type": "number"
      },
      "title": "Beats S",
      "type": "array"
    },
    "bpm_global": {
      "anyOf": [
        {
          "exclusiveMaximum": 400.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bpm Global"
    },
    "downbeats_s": {
      "items": {
        "type": "number"
      },
      "title": "Downbeats S",
      "type": "array"
    },
    "duration_s": {
      "exclusiveMinimum": 0.0,
      "title": "Duration S",
      "type": "number"
    },
    "file": {
      "description": "Project-relative path of the source audio.",
      "title": "File",
      "type": "string"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/GridCorrection"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Beat-grid correction over the tracker output (WP12). beats_s, downbeats_s and bpm_global are always the EFFECTIVE grid; absent = the tracker's grid as-is (analyses written before WP12)."
    },
    "key": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeyEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "loudness_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Loudness Lufs"
    },
    "reliability": {
      "anyOf": [
        {
          "$ref": "#/$defs/GridReliability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sample_rate": {
      "exclusiveMinimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    },
    "schema_version": {
      "const": 0,
      "default": 0,
      "title": "Schema Version",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "separation_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Separation Model"
    },
    "source_id": {
      "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "stems": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stems"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tempo_variable": {
      "default": false,
      "title": "Tempo Variable",
      "type": "boolean"
    }
  },
  "required": [
    "source_id",
    "file",
    "duration_s",
    "sample_rate"
  ],
  "title": "Analysis",
  "type": "object"
}

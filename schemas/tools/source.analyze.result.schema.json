{
  "$defs": {
    "AnalysisSummary": {
      "additionalProperties": false,
      "description": "analysis.json minus the beat lists (``beats_s``, ``downbeats_s``, raw grid):\na 4-minute record has ~1000 beats, which do not belong in an LLM context.",
      "properties": {
        "bpm_global": {
          "title": "Bpm Global",
          "type": "number"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "file": {
          "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
          "title": "File",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loudness_lufs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Lufs"
        },
        "n_beats": {
          "title": "N Beats",
          "type": "integer"
        },
        "n_downbeats": {
          "title": "N Downbeats",
          "type": "integer"
        },
        "sample_rate": {
          "title": "Sample Rate",
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "separation_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separation Model"
        },
        "source_id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "stems": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stems"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tempo_variable": {
          "title": "Tempo Variable",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "file",
        "duration_s",
        "sample_rate",
        "bpm_global",
        "tempo_variable",
        "n_beats",
        "n_downbeats"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "GridAlternative": {
      "additionalProperties": false,
      "description": "Another plausible reading of the grid, as ready-to-pass source.regrid params.",
      "properties": {
        "beat_phase": {
          "default": 0,
          "enum": [
            0,
            1
          ],
          "title": "Beat Phase",
          "type": "integer"
        },
        "bpm": {
          "description": "Global tempo of this reading.",
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "downbeat_shift_beats": {
          "default": 0,
          "title": "Downbeat Shift Beats",
          "type": "integer"
        },
        "label": {
          "description": "Short Spanish description for the human.",
          "title": "Label",
          "type": "string"
        },
        "tempo_factor": {
          "enum": [
            0.5,
            1.0,
            2.0
          ],
          "title": "Tempo Factor",
          "type": "number"
        }
      },
      "required": [
        "tempo_factor",
        "bpm",
        "label"
      ],
      "title": "GridAlternative",
      "type": "object"
    },
    "GridReport": {
      "additionalProperties": false,
      "description": "Compact view of a source's beat grid and how it was corrected (no beat lists).",
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/GridAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "ask_human": {
          "title": "Ask Human",
          "type": "boolean"
        },
        "bar_phase_confidence": {
          "title": "Bar Phase Confidence",
          "type": "number"
        },
        "beat_phase": {
          "title": "Beat Phase",
          "type": "integer"
        },
        "beats_per_bar": {
          "title": "Beats Per Bar",
          "type": "integer"
        },
        "bpm": {
          "description": "Effective global tempo (what chops and the song use).",
          "title": "Bpm",
          "type": "number"
        },
        "corrected": {
          "description": "True when the effective grid differs from the raw one.",
          "title": "Corrected",
          "type": "boolean"
        },
        "downbeat_shift_beats": {
          "title": "Downbeat Shift Beats",
          "type": "integer"
        },
        "first_downbeats_s": {
          "description": "First 4 downbeats (seconds), to locate the 'one'.",
          "items": {
            "type": "number"
          },
          "title": "First Downbeats S",
          "type": "array"
        },
        "n_beats": {
          "title": "N Beats",
          "type": "integer"
        },
        "n_downbeats": {
          "title": "N Downbeats",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "tracker",
            "auto",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "raw_bpm": {
          "description": "Tempo as the beat tracker read it.",
          "title": "Raw Bpm",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "tempo_confidence": {
          "title": "Tempo Confidence",
          "type": "number"
        },
        "tempo_factor": {
          "title": "Tempo Factor",
          "type": "number"
        },
        "tempo_range_bpm": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Tempo Range Bpm",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "bpm",
        "raw_bpm",
        "corrected",
        "origin",
        "tempo_factor",
        "beat_phase",
        "downbeat_shift_beats",
        "beats_per_bar",
        "tempo_range_bpm",
        "tempo_confidence",
        "bar_phase_confidence",
        "ask_human",
        "reason",
        "n_beats",
        "n_downbeats"
      ],
      "title": "GridReport",
      "type": "object"
    },
    "KeyEstimate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "title": "Mode",
          "type": "string"
        },
        "tonic": {
          "description": "Tonic note, e.g. 'A', 'F#', 'Bb'.",
          "pattern": "^[A-G](#|b)?$",
          "title": "Tonic",
          "type": "string"
        }
      },
      "required": [
        "tonic",
        "mode",
        "confidence"
      ],
      "title": "KeyEstimate",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "minimum": 0.0,
          "title": "End S",
          "type": "number"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start_s": {
          "minimum": 0.0,
          "title": "Start S",
          "type": "number"
        }
      },
      "required": [
        "label",
        "start_s",
        "end_s"
      ],
      "title": "Section",
      "type": "object"
    },
    "Stems": {
      "additionalProperties": false,
      "description": "Relative paths to separated stem files under cache/stems/<source_id>/.\n\nAt least one stem must be present; a 2-stem separation may only have\nsome of them. The full mix is the source file itself, so there is no\n'mix' field here ('mix' exists only as a chop stem choice).",
      "properties": {
        "bass": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bass"
        },
        "drums": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drums"
        },
        "other": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other"
        },
        "vocals": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocals"
        }
      },
      "title": "Stems",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "$ref": "#/$defs/AnalysisSummary",
      "description": "analysis.json without the beat lists (read the file for those)."
    },
    "analysis_path": {
      "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
      "title": "Analysis Path",
      "type": "string"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "grid": {
      "$ref": "#/$defs/GridReport",
      "description": "How the beat grid was read and corrected (WP12)."
    },
    "hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent-facing note, e.g. confirm the grid by ear.",
      "title": "Hint"
    },
    "source_id": {
      "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "analysis_path",
    "analysis",
    "grid"
  ],
  "title": "SourceAnalyzeResult",
  "type": "object"
}

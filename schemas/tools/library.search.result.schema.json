{
  "$defs": {
    "LibraryHit": {
      "additionalProperties": false,
      "description": "A search/lookup result, usable directly in song.yaml.",
      "properties": {
        "bpm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bpm"
        },
        "key": {
          "anyOf": [
            {
              "description": "Musical key, canonical form 'F#m' (minor) or 'F#' (major). Accepted: 'F#m', 'F#min', 'F# minor', 'F#', 'F#M', 'F#maj', bare lowercase 'a' = A minor.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "path": {
          "description": "Path relative to its library root.",
          "title": "Path",
          "type": "string"
        },
        "root": {
          "description": "The library root this hit lives in, as configured (may be absolute).",
          "title": "Root",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. kick/snare/clap/hat/loop/oneshot.",
          "title": "Type"
        },
        "uri": {
          "description": "library:// URI usable in song.yaml.",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "root",
        "path"
      ],
      "title": "LibraryHit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/LibraryHit"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "title": "LibrarySearchResult",
  "type": "object"
}

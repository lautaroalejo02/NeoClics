{
  "additionalProperties": false,
  "properties": {
    "detail": {
      "default": false,
      "description": "Also return the full metrics report (~10 KB); by default only the summary (the file is always written to metrics_path).",
      "title": "Detail",
      "type": "boolean"
    },
    "project": {
      "description": "Path to the project directory.",
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "type": "string"
        },
        {
          "pattern": "^d-[0-9a-f]{12}$",
          "type": "string"
        }
      ],
      "description": "Version ('v001') or draft_id ('d-\u2026') to analyze.",
      "title": "Version"
    }
  },
  "required": [
    "project",
    "version"
  ],
  "title": "EarsAnalyzeParams",
  "type": "object"
}

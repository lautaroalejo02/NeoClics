{
  "$defs": {
    "ABChoiceEvent": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "B",
          "type": "string"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "ab_choice",
          "default": "ab_choice",
          "title": "Type",
          "type": "string"
        },
        "winner": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "a",
        "b",
        "winner"
      ],
      "title": "ABChoiceEvent",
      "type": "object"
    },
    "ChopAdjust": {
      "additionalProperties": false,
      "description": "Beat deltas applied by ``chops.choose`` (may be negative).",
      "properties": {
        "length_beats": {
          "default": 0.0,
          "title": "Length Beats",
          "type": "number"
        },
        "start_beats": {
          "default": 0.0,
          "title": "Start Beats",
          "type": "number"
        }
      },
      "title": "ChopAdjust",
      "type": "object"
    },
    "ChopChoiceEvent": {
      "additionalProperties": false,
      "description": "A manual chop selection (UI, mode 'manual'); overrides the agent pick.",
      "properties": {
        "adjust": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChopAdjust"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_id": {
          "description": "Global candidate id 'csNNN/candN', e.g. 'cs001/cand2'.",
          "pattern": "^cs\\d{3,}/cand\\d+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "chop_choice",
          "default": "chop_choice",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "description": "Render version id like 'v001'.",
              "pattern": "^v\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "ts",
        "candidate_id"
      ],
      "title": "ChopChoiceEvent",
      "type": "object"
    },
    "ClipRef": {
      "additionalProperties": false,
      "properties": {
        "clip": {
          "description": "0-based clip index in tracks.<track>.clips.",
          "minimum": 0,
          "title": "Clip",
          "type": "integer"
        },
        "instance": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based pass (repeat).",
          "title": "Instance"
        }
      },
      "required": [
        "clip"
      ],
      "title": "ClipRef",
      "type": "object"
    },
    "CommentEvent": {
      "additionalProperties": false,
      "description": "Free text. WP16: with selection it is a request about exactly those\nelements (\"Pedile al agente\"); song_revision is the song.state revision\nthe human was looking at.",
      "properties": {
        "at_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At S"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "song_revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Song Revision"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "comment",
          "default": "comment",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "description": "Render version id like 'v001'.",
              "pattern": "^v\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "ts",
        "text"
      ],
      "title": "CommentEvent",
      "type": "object"
    },
    "HitRef": {
      "additionalProperties": false,
      "properties": {
        "bar": {
          "description": "Song bar (1-indexed).",
          "minimum": 1,
          "title": "Bar",
          "type": "integer"
        },
        "beat": {
          "description": "1-indexed song beat of the hit.",
          "minimum": 1.0,
          "title": "Beat",
          "type": "number"
        },
        "index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pattern.hits index (free hits).",
          "title": "Index"
        },
        "lane": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Lane",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based grid step; null = free hit.",
          "title": "Step"
        }
      },
      "required": [
        "lane",
        "bar",
        "beat"
      ],
      "title": "HitRef",
      "type": "object"
    },
    "NoteRef": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "minimum": 1.0,
          "title": "Beat",
          "type": "number"
        },
        "index": {
          "description": "0-based index in tracks.<track>.notes.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "phrase": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The note belongs to this phrase.",
          "title": "Phrase"
        },
        "pitch": {
          "maximum": 127,
          "minimum": 0,
          "title": "Pitch",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "beat",
        "pitch"
      ],
      "title": "NoteRef",
      "type": "object"
    },
    "RatingEvent": {
      "additionalProperties": false,
      "properties": {
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "rating",
          "default": "rating",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "enum": [
            "like",
            "dislike"
          ],
          "title": "Value",
          "type": "string"
        },
        "version": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "version",
        "value"
      ],
      "title": "RatingEvent",
      "type": "object"
    },
    "Selection": {
      "additionalProperties": false,
      "description": "What the human pointed at in the editor (WP16). Positions are musical:\nstart_beat/end_beat are 1-indexed song beats, end exclusive.",
      "properties": {
        "automation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Automation target path.",
          "title": "Automation"
        },
        "chop": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chop"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/ClipRef"
          },
          "title": "Clips",
          "type": "array"
        },
        "end_beat": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Beat"
        },
        "excerpt": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The selected elements as they were (song.yaml values).",
          "title": "Excerpt"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/HitRef"
          },
          "title": "Hits",
          "type": "array"
        },
        "label": {
          "description": "Spanish description, e.g. 'bombo, comp\u00e1s 7'.",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lane": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lane"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/NoteRef"
          },
          "title": "Notes",
          "type": "array"
        },
        "paths": {
          "description": "song.edit paths of the selected elements (versions.diff grammar).",
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "points": {
          "description": "0-based automation point indices.",
          "items": {
            "type": "integer"
          },
          "title": "Points",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_s": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[start_s, end_s) inside the source (source view).",
          "title": "Source S"
        },
        "start_beat": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Beat"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "required": [
        "label"
      ],
      "title": "Selection",
      "type": "object"
    },
    "SkippedFeedbackLine": {
      "additionalProperties": false,
      "description": "Report of a feedback.jsonl line that could not be parsed.",
      "properties": {
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "message",
        "hint"
      ],
      "title": "SkippedFeedbackLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "count": {
      "default": 0,
      "title": "Count",
      "type": "integer"
    },
    "digest": {
      "description": "One readable line per event (WP16): requests about an editor selection say what was pointed at and the song.edit op that acts on it.",
      "items": {
        "type": "string"
      },
      "title": "Digest",
      "type": "array"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "ab_choice": "#/$defs/ABChoiceEvent",
            "chop_choice": "#/$defs/ChopChoiceEvent",
            "comment": "#/$defs/CommentEvent",
            "rating": "#/$defs/RatingEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RatingEvent"
          },
          {
            "$ref": "#/$defs/CommentEvent"
          },
          {
            "$ref": "#/$defs/ABChoiceEvent"
          },
          {
            "$ref": "#/$defs/ChopChoiceEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "latest_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ts of the newest returned event.",
      "title": "Latest Ts"
    },
    "next_cursor": {
      "description": "Line count read so far; feed back as 'cursor' to get exactly the events appended later (>=-safe, no timestamp ties).",
      "minimum": 0,
      "title": "Next Cursor",
      "type": "integer"
    },
    "skipped": {
      "description": "feedback.jsonl lines that were skipped (path + line + hint).",
      "items": {
        "$ref": "#/$defs/SkippedFeedbackLine"
      },
      "title": "Skipped",
      "type": "array"
    }
  },
  "required": [
    "next_cursor"
  ],
  "title": "FeedbackReadResult",
  "type": "object"
}

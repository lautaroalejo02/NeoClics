{
  "$defs": {
    "Cleanup": {
      "additionalProperties": false,
      "properties": {
        "dedupe_ms": {
          "default": 0.0,
          "description": "Merge presses of one pad closer than this.",
          "maximum": 200.0,
          "minimum": 0.0,
          "title": "Dedupe Ms",
          "type": "number"
        },
        "velocity": {
          "default": "as_played",
          "enum": [
            "as_played",
            "fixed",
            "even"
          ],
          "title": "Velocity",
          "type": "string"
        },
        "velocity_value": {
          "default": 0.8,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Velocity Value",
          "type": "number"
        }
      },
      "title": "Cleanup",
      "type": "object"
    },
    "TakeQuantize": {
      "additionalProperties": false,
      "description": "Non-destructive quantise of a take (applied on read/commit).\n\n``strength`` 0..1 moves each hit that fraction of the way to the nearest\ngrid point; ``swing`` 0..1 delays the odd (off) points of a straight grid\nby ``swing * step / 3`` (the song's pattern swing; 1 = full triplet feel;\ntriplet grids ignore it).",
      "properties": {
        "grid": {
          "default": "off",
          "enum": [
            "off",
            "1/16",
            "1/8",
            "1/8t",
            "1/16t"
          ],
          "title": "Grid",
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "swing": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Swing",
          "type": "number"
        }
      },
      "title": "TakeQuantize",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at_bar": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Also give 1-indexed song beats as if placed here.",
      "title": "At Bar"
    },
    "cleanup": {
      "$ref": "#/$defs/Cleanup"
    },
    "project": {
      "description": "Path to the project directory.",
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "quantize": {
      "anyOf": [
        {
          "$ref": "#/$defs/TakeQuantize"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Override the take's stored quantise for this read."
    },
    "take_id": {
      "pattern": "^t[0-9]{3,}$",
      "title": "Take Id",
      "type": "string"
    }
  },
  "required": [
    "project",
    "take_id"
  ],
  "title": "TakeGetParams",
  "type": "object"
}

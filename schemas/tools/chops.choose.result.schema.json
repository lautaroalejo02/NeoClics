{
  "$defs": {
    "Chop": {
      "additionalProperties": false,
      "description": "A loop cut from a source stem, aligned to the source's real grid.",
      "properties": {
        "fade_ms": {
          "default": 5.0,
          "description": "Seam crossfade (ms) between back-to-back repeats; fade to/from silence only at the first start and last end of a run. 0 = hard cuts.",
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fade Ms",
          "type": "number"
        },
        "id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "length_beats": {
          "exclusiveMinimum": 0,
          "maximum": 128,
          "title": "Length Beats",
          "type": "number"
        },
        "source": {
          "description": "id of a sources[] entry.",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "start_downbeat": {
          "description": "1-based index into analysis.json downbeats_s.",
          "minimum": 1,
          "title": "Start Downbeat",
          "type": "integer"
        },
        "start_offset_beats": {
          "default": 0.0,
          "description": "Beats to shift the start along beats_s from the downbeat's matching beat; may be negative, fractional interpolates. Enables off-downbeat starts and stutters.",
          "maximum": 4096.0,
          "minimum": -4096.0,
          "title": "Start Offset Beats",
          "type": "number"
        },
        "stem": {
          "default": "other",
          "enum": [
            "drums",
            "bass",
            "vocals",
            "other",
            "mix"
          ],
          "title": "Stem",
          "type": "string"
        },
        "warp": {
          "$ref": "#/$defs/Warp"
        }
      },
      "required": [
        "id",
        "source",
        "start_downbeat",
        "length_beats"
      ],
      "title": "Chop",
      "type": "object"
    },
    "RepeatChange": {
      "additionalProperties": false,
      "properties": {
        "clip": {
          "description": "0-based clip index on the track.",
          "title": "Clip",
          "type": "integer"
        },
        "new_repeat": {
          "title": "New Repeat",
          "type": "integer"
        },
        "old_repeat": {
          "title": "Old Repeat",
          "type": "integer"
        },
        "track": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "track",
        "clip",
        "old_repeat",
        "new_repeat"
      ],
      "title": "RepeatChange",
      "type": "object"
    },
    "Warp": {
      "additionalProperties": false,
      "description": "How source audio conforms to the project tempo.\n\n* ``resample``: the playback rate is set by tempo ONLY,\n  ``project_bpm / source_local_bpm``, so the chop always fills its\n  grid slot exactly; the tempo-induced pitch change IS the vinyl\n  effect. A single rate is used for the whole chop.\n* ``stretch``: pitch-preserving time-stretch to the grid (Rubber\n  Band; each source beat is mapped onto the project grid, beat-wise).\n\nIn both modes ``pitch_semitones`` is an additional LENGTH-PRESERVING\npitch shift (high-quality shifter), applied after the warp \u2014 it never\nchanges the chop's grid span.",
      "properties": {
        "formants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Preserve formants when pitch_semitones != 0. Default: on for stem: vocals only (measured: it colours instruments and drums).",
          "title": "Formants"
        },
        "mode": {
          "default": "resample",
          "enum": [
            "resample",
            "stretch"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pitch_semitones": {
          "default": 0.0,
          "maximum": 24.0,
          "minimum": -24.0,
          "title": "Pitch Semitones",
          "type": "number"
        }
      },
      "title": "Warp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_todo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the agent must still change in song.yaml, if anything.",
      "title": "Agent Todo"
    },
    "candidate_id": {
      "description": "Global chop candidate id '<csNNN>/<candN>', e.g. 'cs001/cand2'.",
      "pattern": "^cs\\d{3,}/cand\\d+$",
      "title": "Candidate Id",
      "type": "string"
    },
    "chop": {
      "$ref": "#/$defs/Chop",
      "description": "The chop written into song.yaml."
    },
    "chop_id": {
      "anyOf": [
        {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Id actually written: chop_id, or a NEW id when the new length cannot keep the clips' span (then see agent_todo).",
      "title": "Chop Id"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Spanish, shown to the human.",
      "title": "Message"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "recorded": {
      "default": false,
      "title": "Recorded",
      "type": "boolean"
    },
    "repeat_changes": {
      "description": "Clip repeats rescaled so each clip keeps its span in beats.",
      "items": {
        "$ref": "#/$defs/RepeatChange"
      },
      "title": "Repeat Changes",
      "type": "array"
    },
    "requested_chop_id": {
      "anyOf": [
        {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Chop Id"
    },
    "rescaled": {
      "default": false,
      "title": "Rescaled",
      "type": "boolean"
    },
    "set_id": {
      "title": "Set Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "set_id",
    "candidate_id",
    "chop"
  ],
  "title": "ChopsChooseResult",
  "type": "object"
}

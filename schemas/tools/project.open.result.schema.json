{
  "$defs": {
    "LibraryConfig": {
      "additionalProperties": false,
      "description": "``[library]`` section: the sample-library roots.",
      "properties": {
        "roots": {
          "description": "Library roots searched by 'library://' URIs, in order. Relative paths resolve against the project dir ('..' allowed); absolute paths are allowed. Each root's index lives inside the root as '.muestra-index.json'.",
          "items": {
            "type": "string"
          },
          "title": "Roots",
          "type": "array"
        }
      },
      "title": "LibraryConfig",
      "type": "object"
    },
    "PluginPaths": {
      "additionalProperties": false,
      "description": "OS-specific install paths for one plugin alias.",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linux"
        },
        "macos": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macos"
        },
        "windows": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Windows"
        }
      },
      "title": "PluginPaths",
      "type": "object"
    },
    "PluginsConfig": {
      "additionalProperties": false,
      "description": "``[plugins]`` section: plugin aliases and extra search dirs.\n\nIn muestra.toml the aliases sit directly inside ``[plugins]``::\n\n    [plugins]\n    search_dirs = [\"C:/VST3\"]\n    surge-xt = {windows = \"C:/VST3/Surge XT.vst3\", macos = \"/Library/...vst3\"}",
      "properties": {
        "aliases": {
          "additionalProperties": {
            "$ref": "#/$defs/PluginPaths"
          },
          "description": "alias -> per-OS path table (populated from the extra keys of [plugins]).",
          "title": "Aliases",
          "type": "object"
        },
        "search_dirs": {
          "description": "Extra directories scanned for VST3/AU plugins.",
          "items": {
            "type": "string"
          },
          "title": "Search Dirs",
          "type": "array"
        }
      },
      "title": "PluginsConfig",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "export_bit_depth": {
          "default": 24,
          "enum": [
            16,
            24,
            32
          ],
          "title": "Export Bit Depth",
          "type": "integer"
        },
        "library": {
          "$ref": "#/$defs/LibraryConfig"
        },
        "plugins": {
          "$ref": "#/$defs/PluginsConfig"
        },
        "sample_rate": {
          "default": 48000,
          "description": "Internal render sample rate (Hz).",
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": 0,
          "default": 0,
          "title": "Schema Version",
          "type": "integer"
        },
        "separation": {
          "$ref": "#/$defs/SeparationConfig"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "SeparationConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "audio-separator",
          "description": "Separation backend name, e.g. 'audio-separator'.",
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model name/version understood by the backend.",
          "title": "Model"
        }
      },
      "title": "SeparationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "has_song": {
      "title": "Has Song",
      "type": "boolean"
    },
    "project_path": {
      "title": "Project Path",
      "type": "string"
    },
    "sources": {
      "description": "Source ids from song.yaml.",
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "versions": {
      "description": "Existing renders/vNNN dirs.",
      "items": {
        "type": "string"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "project_path",
    "config",
    "has_song"
  ],
  "title": "ProjectOpenResult",
  "type": "object"
}

{
  "$defs": {
    "AlarmRef": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "AlarmRef",
      "type": "object"
    },
    "DiffItem": {
      "additionalProperties": false,
      "description": "A :class:`DiffEntry` that serialises its ``from_`` field as ``from``\n(the contract's JSON name) even without ``by_alias=True``, which is how the\ntool envelope dumps results.",
      "properties": {
        "from": {
          "default": null,
          "title": "From"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "to": {
          "default": null,
          "title": "To"
        }
      },
      "required": [
        "path"
      ],
      "title": "DiffItem",
      "type": "object"
    },
    "MetricsDelta": {
      "additionalProperties": false,
      "description": "Difference between two versions' metrics (b relative to a).",
      "properties": {
        "alarms_fixed": {
          "items": {
            "$ref": "#/$defs/AlarmRef"
          },
          "title": "Alarms Fixed",
          "type": "array"
        },
        "alarms_introduced": {
          "items": {
            "$ref": "#/$defs/AlarmRef"
          },
          "title": "Alarms Introduced",
          "type": "array"
        },
        "alarms_kept": {
          "items": {
            "$ref": "#/$defs/AlarmRef"
          },
          "title": "Alarms Kept",
          "type": "array"
        },
        "balance_delta_db": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Per mix role (kick/drums/bass/sample/other): change of the role's level relative to the loudest role, dB (b relative to a).",
          "title": "Balance Delta Db",
          "type": "object"
        },
        "brightness": {
          "anyOf": [
            {
              "enum": [
                "brighter",
                "darker",
                "same"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brightness"
        },
        "high_delta_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Change of the 4-20 kHz share of the mix, dB.",
          "title": "High Delta Db"
        },
        "loudness": {
          "anyOf": [
            {
              "enum": [
                "louder",
                "quieter",
                "same"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness"
        },
        "low_delta_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Change of the 20-250 Hz share of the mix, dB.",
          "title": "Low Delta Db"
        },
        "low_end": {
          "anyOf": [
            {
              "enum": [
                "heavier",
                "lighter",
                "same"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low End"
        },
        "lufs_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "b - a, integrated LUFS.",
          "title": "Lufs Delta"
        },
        "notes": {
          "description": "Short Spanish notes.",
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "plr_delta_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plr Delta Db"
        },
        "track_level_delta_db": {
          "description": "Per track stem RMS change, dB.",
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "type": "number"
            }
          },
          "propertyNames": {
            "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": "Track Level Delta Db",
          "type": "object"
        },
        "true_peak_delta_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "True Peak Delta Db"
        },
        "version_a": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version A",
          "type": "string"
        },
        "version_b": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version B",
          "type": "string"
        }
      },
      "required": [
        "version_a",
        "version_b"
      ],
      "title": "MetricsDelta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "a": {
      "description": "Render version id like 'v001'.",
      "pattern": "^v\\d{3,}$",
      "title": "A",
      "type": "string"
    },
    "b": {
      "description": "Render version id like 'v001'.",
      "pattern": "^v\\d{3,}$",
      "title": "B",
      "type": "string"
    },
    "changes": {
      "description": "The musical diff as separate Spanish sentences (one bullet each).",
      "items": {
        "type": "string"
      },
      "title": "Changes",
      "type": "array"
    },
    "diff": {
      "description": "Changed fields; ID-based song.yaml paths (chops.c1.warp.pitch_semitones, tracks.drums.pattern.lanes.kick.steps, tracks.<id>.clips[<i>], fx[<i>] for id-less fx).",
      "items": {
        "$ref": "#/$defs/DiffItem"
      },
      "title": "Diff",
      "type": "array"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "identical": {
      "default": false,
      "description": "True when the two songs have no structural difference.",
      "title": "Identical",
      "type": "boolean"
    },
    "metrics_compare": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricsDelta"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured ears comparison (loudness, brightness, low end, per-track levels, alarms fixed/introduced/kept); null unless both versions have metrics."
    },
    "metrics_delta": {
      "description": "Spanish phrases on how the metrics moved; empty unless both versions have a metrics.json.",
      "items": {
        "type": "string"
      },
      "title": "Metrics Delta",
      "type": "array"
    },
    "musical_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable musical diff in Spanish (WP5).",
      "title": "Musical Summary"
    }
  },
  "required": [
    "a",
    "b"
  ],
  "title": "VersionsDiffResult",
  "type": "object"
}

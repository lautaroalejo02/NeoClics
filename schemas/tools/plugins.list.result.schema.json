{
  "$defs": {
    "AliasEntry": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Errors",
          "type": "array"
        },
        "plugin": {
          "title": "Plugin",
          "type": "string"
        },
        "preset": {
          "title": "Preset",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "plugin",
        "preset",
        "available",
        "reason"
      ],
      "title": "AliasEntry",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "One machine-readable problem. Agents consume these to fix files.\n\nAttributes:\n    path: Dotted/bracketed location inside the offending file, e.g.\n        ``tracks[1].fx[2].cutoff_hz``. Empty string means the problem\n        is about the file (or project) as a whole.\n    code: Stable machine-readable code, e.g. ``unknown_field``,\n        ``ref_not_found``, ``file_not_found``.\n    message: Human-readable description of what is wrong.\n    hint: Short actionable fix suggestion, when one is known.\n    value: ``repr()`` of the offending value, if there is one.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "PluginEntry": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Errors",
          "type": "array"
        },
        "is_effect": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Effect"
        },
        "is_instrument": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Instrument"
        },
        "latency_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Samples"
        },
        "n_parameters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter count (names only with detail=true).",
          "title": "N Parameters"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameter_info": {
          "additionalProperties": true,
          "title": "Parameter Info",
          "type": "object"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "default": "unprobed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "name"
      ],
      "title": "PluginEntry",
      "type": "object"
    },
    "PresetEntry": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Errors",
          "type": "array"
        },
        "name": {
          "description": "What to write in instrument.preset (Surge: 'Category/Name').",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File path (detail=true only).",
          "title": "Path"
        },
        "plugin": {
          "title": "Plugin",
          "type": "string"
        },
        "supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supported"
        }
      },
      "required": [
        "name",
        "plugin"
      ],
      "title": "PresetEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "description": "Curated instruments ready for future funk: use these first.",
      "items": {
        "$ref": "#/$defs/AliasEntry"
      },
      "title": "Aliases",
      "type": "array"
    },
    "categories": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "description": "plugin -> category -> preset count.",
      "title": "Categories",
      "type": "object"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "hint": {
      "default": "Run plugins.scan to probe native plugins before use.",
      "title": "Hint",
      "type": "string"
    },
    "matched": {
      "default": 0,
      "description": "Presets matching the filters (all pages).",
      "title": "Matched",
      "type": "integer"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "offset of the next page, if any.",
      "title": "Next Offset"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/PluginEntry"
      },
      "title": "Plugins",
      "type": "array"
    },
    "preset_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Presets per plugin (all of them, unfiltered).",
      "title": "Preset Counts",
      "type": "object"
    },
    "presets": {
      "description": "One page of matching presets; empty unless query/plugin/category is set.",
      "items": {
        "$ref": "#/$defs/PresetEntry"
      },
      "title": "Presets",
      "type": "array"
    },
    "search_dirs": {
      "items": {
        "type": "string"
      },
      "title": "Search Dirs",
      "type": "array"
    }
  },
  "required": [
    "aliases",
    "plugins",
    "search_dirs"
  ],
  "title": "PluginsListResult",
  "type": "object"
}

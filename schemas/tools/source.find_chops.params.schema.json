{
  "additionalProperties": false,
  "properties": {
    "at_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact spot ('el riff del 0:15'): seconds or 'm:ss'. Candidate 1 starts on the downbeat nearest it; set length_beats too.",
      "title": "At S"
    },
    "length_beats": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Loop length in beats (default: compare 1/2/4/8 bars).",
      "title": "Length Beats"
    },
    "n": {
      "default": 3,
      "description": "Number of candidates to propose.",
      "minimum": 1,
      "title": "N",
      "type": "integer"
    },
    "project": {
      "description": "Path to the project directory.",
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Section label from analysis.json to chop from.",
      "title": "Section"
    },
    "source_id": {
      "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "stem": {
      "anyOf": [
        {
          "enum": [
            "drums",
            "bass",
            "vocals",
            "other",
            "mix"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stem to chop (default: 'other').",
      "title": "Stem"
    },
    "window_s": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Only loops lying inside [start_s, end_s] of the record, e.g. [0, 30] for 'the riff at the start'. Combines with section.",
      "title": "Window S"
    }
  },
  "required": [
    "project",
    "source_id"
  ],
  "title": "SourceFindChopsParams",
  "type": "object"
}

{
  "$defs": {
    "Alarm": {
      "additionalProperties": false,
      "description": "A computed heads-up for the agent (\"metrics are alarms\").",
      "properties": {
        "at_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At S"
        },
        "code": {
          "description": "Stable machine code, e.g. 'clipping'.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Alarm",
      "type": "object"
    },
    "AlignmentReport": {
      "additionalProperties": false,
      "properties": {
        "max_abs_offset_ms": {
          "minimum": 0.0,
          "title": "Max Abs Offset Ms",
          "type": "number"
        },
        "tracks": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/TrackAlignment"
            }
          },
          "propertyNames": {
            "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": "Tracks",
          "type": "object"
        }
      },
      "required": [
        "max_abs_offset_ms"
      ],
      "title": "AlignmentReport",
      "type": "object"
    },
    "ClickEvent": {
      "additionalProperties": false,
      "description": "A suspected click/discontinuity at a chop or clip edge.",
      "properties": {
        "at_s": {
          "minimum": 0.0,
          "title": "At S",
          "type": "number"
        },
        "severity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity",
          "type": "number"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        }
      },
      "required": [
        "at_s",
        "severity"
      ],
      "title": "ClickEvent",
      "type": "object"
    },
    "ClickReport": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ClickEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "count"
      ],
      "title": "ClickReport",
      "type": "object"
    },
    "DiffEntry": {
      "additionalProperties": false,
      "description": "One changed value in the musical diff between versions.\n\n``path`` uses ID-based song.yaml addressing, matching the automation\ngrammar: ``chops.c1.warp.pitch_semitones``,\n``tracks.sample.fx.lp.cutoff_hz``,\n``tracks.drums.pattern.lanes.kick.steps``, ``meta.bpm``. Elements\nwithout ids use indices: ``tracks.<id>.clips[<i>]``, and an fx\nwithout an ``id`` is addressed as ``fx[<i>]``.\n``from_`` serializes as ``from``.",
      "properties": {
        "from": {
          "default": null,
          "title": "From"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "to": {
          "default": null,
          "title": "To"
        }
      },
      "required": [
        "path"
      ],
      "title": "DiffEntry",
      "type": "object"
    },
    "KeyEstimate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "mode": {
          "enum": [
            "major",
            "minor"
          ],
          "title": "Mode",
          "type": "string"
        },
        "tonic": {
          "description": "Tonic note, e.g. 'A', 'F#', 'Bb'.",
          "pattern": "^[A-G](#|b)?$",
          "title": "Tonic",
          "type": "string"
        }
      },
      "required": [
        "tonic",
        "mode",
        "confidence"
      ],
      "title": "KeyEstimate",
      "type": "object"
    },
    "Loudness": {
      "additionalProperties": false,
      "properties": {
        "clipped_samples": {
          "default": 0,
          "minimum": 0,
          "title": "Clipped Samples",
          "type": "integer"
        },
        "clipping": {
          "title": "Clipping",
          "type": "boolean"
        },
        "integrated_lufs": {
          "title": "Integrated Lufs",
          "type": "number"
        },
        "true_peak_dbtp": {
          "title": "True Peak Dbtp",
          "type": "number"
        }
      },
      "required": [
        "integrated_lufs",
        "true_peak_dbtp",
        "clipping"
      ],
      "title": "Loudness",
      "type": "object"
    },
    "LowEndMasking": {
      "additionalProperties": false,
      "description": "Who owns the low end (the \"el bombo se come al sample\" alarm).\n\n``energy_db`` maps each track id to its mean energy (dB) inside\n``band_hz``; ``dominant_track`` is the loudest there. Track roles\n(kick/bass/sample) are identified by track id/name.",
      "properties": {
        "band_hz": {
          "default": [
            40.0,
            150.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Band Hz",
          "type": "array"
        },
        "dominant_track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dominant Track"
        },
        "energy_db": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "type": "number"
            }
          },
          "propertyNames": {
            "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": "Energy Db",
          "type": "object"
        }
      },
      "title": "LowEndMasking",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "alarms": {
          "items": {
            "$ref": "#/$defs/Alarm"
          },
          "title": "Alarms",
          "type": "array"
        },
        "alignment": {
          "$ref": "#/$defs/AlignmentReport"
        },
        "clicks": {
          "$ref": "#/$defs/ClickReport"
        },
        "loudness": {
          "$ref": "#/$defs/Loudness"
        },
        "low_end_masking": {
          "$ref": "#/$defs/LowEndMasking"
        },
        "schema_version": {
          "const": 0,
          "default": 0,
          "title": "Schema Version",
          "type": "integer"
        },
        "spectral": {
          "$ref": "#/$defs/SpectralReport"
        },
        "style_similarity": {
          "anyOf": [
            {
              "$ref": "#/$defs/StyleSimilarity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tonal": {
          "$ref": "#/$defs/TonalReport"
        },
        "version": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "loudness",
        "spectral",
        "low_end_masking",
        "alignment",
        "tonal",
        "clicks"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "RenderMeta": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "Agent/tool that rendered, e.g. 'claude-code'.",
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "bpm": {
          "exclusiveMaximum": 400,
          "exclusiveMinimum": 0,
          "title": "Bpm",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "diff": {
          "items": {
            "$ref": "#/$defs/DiffEntry"
          },
          "title": "Diff",
          "type": "array"
        },
        "duration_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The version commit in the project's git repo (it contains this version's song.yaml). meta.json/metrics.json are written AFTER the commit and can always be regenerated.",
          "title": "Git Commit"
        },
        "key": {
          "description": "Musical key, canonical form 'F#m' (minor) or 'F#' (major). Accepted: 'F#m', 'F#min', 'F# minor', 'F#', 'F#M', 'F#maj', bare lowercase 'a' = A minor.",
          "title": "Key",
          "type": "string"
        },
        "length_bars": {
          "description": "meta.length_bars of the song at this version.",
          "minimum": 1,
          "title": "Length Bars",
          "type": "integer"
        },
        "mix": {
          "description": "Project-relative path of mix.wav.",
          "title": "Mix",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "description": "Render version id like 'v001'.",
              "pattern": "^v\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "range_bars": {
          "description": "[start, end) 1-indexed bar range that was rendered; end is EXCLUSIVE (default render: [1, length_bars + 1]).",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Range Bars",
          "type": "array"
        },
        "render_time_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Render Time S"
        },
        "request": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The natural-language request that produced this version.",
          "title": "Request"
        },
        "sample_rate": {
          "description": "Project sample rate of every wav in renders/vNNN.",
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "schema_version": {
          "const": 0,
          "default": 0,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Musical (not technical) description of what changed.",
          "title": "Summary"
        },
        "tracks": {
          "description": "Ordered track list with stems, mirroring song.yaml.",
          "items": {
            "$ref": "#/$defs/RenderTrackMeta"
          },
          "title": "Tracks",
          "type": "array"
        },
        "version": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "created_at",
        "agent",
        "sample_rate",
        "bpm",
        "key",
        "length_bars",
        "range_bars",
        "mix"
      ],
      "title": "RenderMeta",
      "type": "object"
    },
    "RenderTrackMeta": {
      "additionalProperties": false,
      "description": "A track's entry in meta.json: id, kind and its stem path(s).",
      "properties": {
        "id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "clips",
            "pattern",
            "instrument"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lanes": {
          "description": "Per-lane stems (pattern tracks only), pre track fx.",
          "items": {
            "$ref": "#/$defs/StemLaneRef"
          },
          "title": "Lanes",
          "type": "array"
        },
        "stem": {
          "description": "Project-relative path of the track stem, e.g. 'renders/v001/stems/drums.wav'.",
          "title": "Stem",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "stem"
      ],
      "title": "RenderTrackMeta",
      "type": "object"
    },
    "SpectralBalance": {
      "additionalProperties": false,
      "description": "Mean band energy in dB for the fixed bands (see BAND_EDGES_HZ).",
      "properties": {
        "high_db": {
          "description": "4000-20000 Hz",
          "title": "High Db",
          "type": "number"
        },
        "low_db": {
          "description": "20-250 Hz",
          "title": "Low Db",
          "type": "number"
        },
        "mid_db": {
          "description": "250-4000 Hz",
          "title": "Mid Db",
          "type": "number"
        }
      },
      "required": [
        "low_db",
        "mid_db",
        "high_db"
      ],
      "title": "SpectralBalance",
      "type": "object"
    },
    "SpectralReport": {
      "additionalProperties": false,
      "properties": {
        "bands_hz": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Bands Hz",
          "type": "object"
        },
        "mix": {
          "$ref": "#/$defs/SpectralBalance"
        },
        "tracks": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/SpectralBalance"
            }
          },
          "propertyNames": {
            "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
          },
          "title": "Tracks",
          "type": "object"
        }
      },
      "required": [
        "mix"
      ],
      "title": "SpectralReport",
      "type": "object"
    },
    "StemLaneRef": {
      "additionalProperties": false,
      "description": "One pattern lane's stem file.",
      "properties": {
        "id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "stem": {
          "description": "Project-relative path, e.g. 'renders/v001/stems/drums.kick.wav'.",
          "title": "Stem",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stem"
      ],
      "title": "StemLaneRef",
      "type": "object"
    },
    "StyleScore": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "description": "Reference identifier, e.g. a path or name.",
          "title": "Reference",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "reference",
        "score"
      ],
      "title": "StyleScore",
      "type": "object"
    },
    "StyleSimilarity": {
      "additionalProperties": false,
      "description": "Optional (spec 10): CLAP/MERT similarity against reference tracks.",
      "properties": {
        "mean_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Score"
        },
        "model": {
          "description": "e.g. 'laion-clap', 'mert'.",
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/StyleScore"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "model"
      ],
      "title": "StyleSimilarity",
      "type": "object"
    },
    "TonalReport": {
      "additionalProperties": false,
      "properties": {
        "estimated": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "in_key": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True iff estimated tonic and mode both match target_key.",
          "title": "In Key"
        },
        "mode_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode Match"
        },
        "target_key": {
          "anyOf": [
            {
              "description": "Musical key, canonical form 'F#m' (minor) or 'F#' (major). Accepted: 'F#m', 'F#min', 'F# minor', 'F#', 'F#M', 'F#maj', bare lowercase 'a' = A minor.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meta.key from song.yaml, normalized.",
          "title": "Target Key"
        },
        "tonic_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tonic Match"
        }
      },
      "title": "TonalReport",
      "type": "object"
    },
    "TrackAlignment": {
      "additionalProperties": false,
      "description": "How far this track's transients sit off the project grid.",
      "properties": {
        "max_abs_offset_ms": {
          "minimum": 0.0,
          "title": "Max Abs Offset Ms",
          "type": "number"
        },
        "mean_offset_ms": {
          "title": "Mean Offset Ms",
          "type": "number"
        },
        "n_transients": {
          "minimum": 0,
          "title": "N Transients",
          "type": "integer"
        }
      },
      "required": [
        "mean_offset_ms",
        "max_abs_offset_ms",
        "n_transients"
      ],
      "title": "TrackAlignment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RenderMeta"
    },
    "meta_path": {
      "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
      "title": "Meta Path",
      "type": "string"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Metrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics_path": {
      "anyOf": [
        {
          "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metrics Path"
    },
    "mix_path": {
      "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
      "title": "Mix Path",
      "type": "string"
    },
    "stem_paths": {
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,63}$": {
          "description": "Project-relative POSIX path ('/' separators, no '..', no absolute paths, no ':' / trailing dots/spaces / reserved names).",
          "type": "string"
        }
      },
      "propertyNames": {
        "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$"
      },
      "title": "Stem Paths",
      "type": "object"
    },
    "version": {
      "description": "Render version id like 'v001'.",
      "pattern": "^v\\d{3,}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "mix_path",
    "meta_path",
    "meta"
  ],
  "title": "RenderResult",
  "type": "object"
}

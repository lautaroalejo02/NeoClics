          "type": "number"
        },
        "type": {
          "const": "sidechain",
          "default": "sidechain",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key_track",
        "depth"
      ],
      "title": "SidechainFx",
      "type": "object"
    },

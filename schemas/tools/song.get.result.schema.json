          "type": "number"
        },
        "rate_hz": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Rate Hz",
          "type": "number"
        },
        "type": {
          "const": "chorus",
          "default": "chorus",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ChorusFx",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "description": "Places a chop or a library sample on a track's grid.\n\nExactly one of ``chop`` / ``sample`` must be set. ``sample`` clips\nneed ``length_beats`` (grid occupancy; audio is truncated at the\nboundary, never looped \u2014 use ``repeat`` to tile) and may carry their\nown ``warp``; the renderer resolves the source BPM from the library\nindex.",
      "properties": {
        "at_bar": {
          "description": "1-indexed bar where the clip starts.",
          "minimum": 1,
          "title": "At Bar",
          "type": "integer"
        },
        "chop": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chop"
        },
        "length_beats": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 4096,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Beats"
        },
        "offset_beats": {
          "default": 0.0,
          "description": "Beat offset added to at_bar; may be negative or fractional.",
          "title": "Offset Beats",
          "type": "number"
        },
        "repeat": {
          "default": 1,
          "maximum": 4096,
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        },
        "sample": {
          "anyOf": [
            {
              "description": "Project-relative POSIX path or 'library://<path>' URI.",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample"
        },
        "warp": {
          "anyOf": [
            {
              "$ref": "#/$defs/Warp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "at_bar"
      ],
      "title": "Clip",
      "type": "object"
    },

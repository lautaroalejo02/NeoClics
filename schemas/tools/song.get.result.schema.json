{
  "$defs": {
    "Automation": {
      "additionalProperties": false,
      "description": "Parameter automation over time.\n\n``points`` are ``[bar, value]`` pairs; bars are 1-indexed, fractional\nallowed, in [1, length_bars + 1] (length_bars + 1 = end of song).\nValue units are the target parameter's own units. ``curve``: ``lin``\nlinear, ``exp`` exponential (values must be non-zero and same-sign),\n``step`` holds the previous value.",
      "properties": {
        "curve": {
          "default": "lin",
          "enum": [
            "lin",
            "exp",
            "step"
          ],
          "title": "Curve",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "target": {
          "description": "tracks.<track_id>.gain_db | tracks.<track_id>.pan | tracks.<track_id>.fx.<fx_id>.<param> | master.gain_db | master.fx.<fx_id>.<param>",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "points"
      ],
      "title": "Automation",
      "type": "object"
    },
    "Chop": {
      "additionalProperties": false,
      "description": "A loop cut from a source stem, aligned to the source's real grid.",
      "properties": {
        "fade_ms": {
          "default": 5.0,
          "maximum": 1000.0,
          "minimum": 0.0,
          "title": "Fade Ms",
          "type": "number"
        },
        "id": {
          "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "length_beats": {
          "exclusiveMinimum": 0,
          "maximum": 128,
          "title": "Length Beats",
          "type": "number"
        },
        "source": {
          "description": "id of a sources[] entry.",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "start_downbeat": {
          "description": "1-based index into analysis.json downbeats_s.",
          "minimum": 1,
          "title": "Start Downbeat",
          "type": "integer"
        },
        "stem": {
          "default": "other",
          "enum": [
            "drums",
            "bass",
            "vocals",
            "other",
            "mix"
          ],
          "title": "Stem",
          "type": "string"
        },
        "warp": {
          "$ref": "#/$defs/Warp"
        }
      },
      "required": [
        "id",
        "source",
        "start_downbeat",
        "length_beats"
      ],
      "title": "Chop",
      "type": "object"
    },
    "ChorusFx": {
      "additionalProperties": false,
      "properties": {
        "centre_delay_ms": {
          "default": 7.0,
          "maximum": 100.0,
          "minimum": 0.0,

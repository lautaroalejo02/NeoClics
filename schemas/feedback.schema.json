{
  "$defs": {
    "ABChoiceEvent": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "B",
          "type": "string"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "ab_choice",
          "default": "ab_choice",
          "title": "Type",
          "type": "string"
        },
        "winner": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Winner",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "a",
        "b",
        "winner"
      ],
      "title": "ABChoiceEvent",
      "type": "object"
    },
    "ChopAdjust": {
      "additionalProperties": false,
      "description": "Beat deltas applied by ``chops.choose`` (may be negative).",
      "properties": {
        "length_beats": {
          "default": 0.0,
          "title": "Length Beats",
          "type": "number"
        },
        "start_beats": {
          "default": 0.0,
          "title": "Start Beats",
          "type": "number"
        }
      },
      "title": "ChopAdjust",
      "type": "object"
    },
    "ChopChoiceEvent": {
      "additionalProperties": false,
      "description": "A manual chop selection (UI, mode 'manual'); overrides the agent pick.",
      "properties": {
        "adjust": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChopAdjust"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_id": {
          "description": "Global candidate id 'csNNN/candN', e.g. 'cs001/cand2'.",
          "pattern": "^cs\\d{3,}/cand\\d+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "chop_choice",
          "default": "chop_choice",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "description": "Render version id like 'v001'.",
              "pattern": "^v\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "ts",
        "candidate_id"
      ],
      "title": "ChopChoiceEvent",
      "type": "object"
    },
    "CommentEvent": {
      "additionalProperties": false,
      "properties": {
        "at_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At S"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "track": {
          "anyOf": [
            {
              "description": "Lowercase slug: ^[a-z][a-z0-9_-]{0,63}$",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track"
        },
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "comment",
          "default": "comment",
          "title": "Type",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "description": "Render version id like 'v001'.",
              "pattern": "^v\\d{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "ts",
        "text"
      ],
      "title": "CommentEvent",
      "type": "object"
    },
    "RatingEvent": {
      "additionalProperties": false,
      "properties": {
        "ts": {
          "description": "ISO-8601 timestamp of the event (timezone-aware, UTC).",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "const": "rating",
          "default": "rating",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "enum": [
            "like",
            "dislike"
          ],
          "title": "Value",
          "type": "string"
        },
        "version": {
          "description": "Render version id like 'v001'.",
          "pattern": "^v\\d{3,}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "ts",
        "version",
        "value"
      ],
      "title": "RatingEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "ab_choice": "#/$defs/ABChoiceEvent",
      "chop_choice": "#/$defs/ChopChoiceEvent",
      "comment": "#/$defs/CommentEvent",
      "rating": "#/$defs/RatingEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RatingEvent"
    },
    {
      "$ref": "#/$defs/CommentEvent"
    },
    {
      "$ref": "#/$defs/ABChoiceEvent"
    },
    {
      "$ref": "#/$defs/ChopChoiceEvent"
    }
  ]
}
